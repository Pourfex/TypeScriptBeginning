{
  "name": "ign-wms-fetcher",
  "version": "1.0.0",
  "description": "CLI tool to fetch images from IGN WMS service",
  "main": "dist/index.js",
  "bin": {
    "ign-wms-fetcher": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "start": "npm run build && node dist/index.js",
    "dev": "tsx src/index.ts",
    "dev:watch": "nodemon --exec tsx src/index.ts"
  },
  "keywords": [
    "cli",
    "typescript",
    "ign",
    "wms",
    "geospatial",
    "imagery",
    "node"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "chalk": "^6.0.0",
    "figlet": "^1.11.4",
    "node-fetch": "^2.7.0",
    "proj4": "^2.7.0"
  },
  "devDependencies": {
    "@types/figlet": "^1.7.0",
    "@types/node": "^26.6.2",
    "nodemon": "^3.1.14",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
	  "@types/proj4": "^2.5.2",
    "@types/node-fetch": "^2.6.4"
  }
}
