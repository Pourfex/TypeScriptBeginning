{
  "name": "typescript-cli-hello-world",
  "version": "1.0.0",
  "description": "TypeScript CLI Hello World application",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "ts-hello": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "start": "npm run build && node dist/index.js",
    "dev": "tsx src/index.ts",
    "dev:watch": "nodemon --exec tsx src/index.ts"
  },
  "keywords": [
    "cli",
    "typescript",
    "hello-world",
    "node"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "chalk": "^6.0.0",
    "figlet": "^1.11.4"
  },
  "devDependencies": {
    "@types/figlet": "^1.7.0",
    "@types/node": "^26.6.2",
    "nodemon": "^3.1.14",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
